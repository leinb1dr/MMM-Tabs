<div class="mmm-tabs">
  {% if showDropdown %}
  <select class="mmm-tabs-select" aria-label="Select page">
    {% for page in pages %}
    <option value="{{ page.index }}"{% if page.index == currentPage %} selected{% endif %}>{{ page.name }}</option>
    {% endfor %}
  </select>
  {% else %}
  <span class="mmm-tabs-current">{{ currentPageName }}</span>
  {% endif %}
</div>
